# ── Telegram ──────────────────────────────────────────────
# 1. В Telegram напишите @BotFather → /newbot → задайте имя и ник бота.
#    BotFather пришлёт токен — вставьте его сюда.
# 2. Добавьте бота в группу клуба и дайте ему право писать сообщения.
# 3. Узнать ID группы: добавьте в неё @getmyid_bot либо откройте
#    https://api.telegram.org/bot<ТОКЕН>/getUpdates после первого
#    сообщения в группе — нужен chat.id (у групп он отрицательный).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Почта (SMTP Яндекса) ──────────────────────────────────
# SMTP_PASS — это НЕ пароль от почты, а пароль приложения:
# id.yandex.ru → Безопасность → Пароли приложений → Почта.
MAIL_TO=octagon.fit@yandex.ru
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=octagon.fit@yandex.ru
SMTP_PASS=

# ── Сервис ────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1
# Домены, с которых принимаются заявки (через запятую).
ALLOWED_ORIGINS=https://octagon-fit.ru,https://octagon-fit.a-4-to.ru
